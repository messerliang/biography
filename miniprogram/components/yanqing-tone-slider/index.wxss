.yanqing-tone-frame {
  position: relative;
  padding: 24rpx 28rpx 20rpx;
  background: linear-gradient(145deg, rgba(255, 248, 250, 0.95) 0%, rgba(252, 243, 245, 0.65) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(196, 140, 160, 0.28);
}

.yanqing-tone-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #9b4d6a;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.yanqing-tone-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 4rpx;
  gap: 8rpx;
}

.yanqing-tone-label-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.yanqing-tone-label-col:first-child {
  align-items: flex-start;
}

.yanqing-tone-label-col:last-child {
  align-items: flex-end;
}

.yanqing-tone-label {
  font-size: 22rpx;
  color: #a89580;
  font-weight: 600;
}

.yanqing-tone-summary {
  font-size: 20rpx;
  color: #c4b5a0;
  margin-top: 4rpx;
}

.yanqing-tone-label-col.active .yanqing-tone-label {
  color: #9b4d6a;
}

.yanqing-tone-label-col.active .yanqing-tone-summary {
  color: #a89580;
}

.yanqing-tone-track {
  position: relative;
  height: 56rpx;
  margin: 8rpx 0 4rpx;
  padding: 4rpx 0;
  box-sizing: border-box;
}

.yanqing-tone-track-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 6rpx;
  margin-top: -3rpx;
  background: #f0e0e6;
  border-radius: 3rpx;
  pointer-events: none;
}

.yanqing-tone-track-fill {
  position: absolute;
  top: 50%;
  left: 0;
  height: 6rpx;
  margin-top: -3rpx;
  background: linear-gradient(90deg, #d4a0b0 0%, #9b4d6a 100%);
  border-radius: 3rpx;
  transition: width 0.2s ease;
  pointer-events: none;
}

.yanqing-tone-track-fill.is-dragging {
  transition: none;
}

.yanqing-tone-track-node {
  position: absolute;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  margin: -8rpx 0 0 -8rpx;
  background: #fff;
  border: 3rpx solid #e8c8d4;
  border-radius: 50%;
  box-sizing: border-box;
  z-index: 2;
  pointer-events: none;
}

.yanqing-tone-track-node.active {
  border-color: #9b4d6a;
  background: #fff5f8;
}

.yanqing-tone-track-thumb {
  position: absolute;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -14rpx;
  background: linear-gradient(135deg, #e8b4c4 0%, #9b4d6a 100%);
  border: 3rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(155, 77, 106, 0.28);
  box-sizing: border-box;
  z-index: 3;
  transition: left 0.2s ease;
  pointer-events: none;
}

.yanqing-tone-track-thumb.is-dragging {
  transition: none;
}

.yanqing-tone-hint {
  font-size: 22rpx;
  color: #a89580;
  line-height: 1.6;
  margin-top: 12rpx;
}
