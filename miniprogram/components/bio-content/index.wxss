.bio-content {
  color: #3d2b1f;
  line-height: 1.7;
}

.bio-main-title {
  text-align: center;
  font-weight: 700;
  color: #3d2b1f;
  margin: 0 0 32rpx;
  line-height: 1.45;
  letter-spacing: 2rpx;
}

.bio-hook {
  text-align: left;
  margin: 0 0 40rpx;
  line-height: 1.65;
  color: #5c5048;
  font-family: "HeroCalligraphy", "STKaiti", "KaiTi", "华文楷体", serif;
}

.bio-chapter {
  text-align: center;
  font-weight: 600;
  color: #3d2b1f;
  margin: 48rpx 0 32rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.bio-chapter:first-child {
  margin-top: 0;
}

.bio-comment-label {
  text-align: center;
  font-weight: 600;
  color: #8b6914;
  margin: 40rpx 0 20rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  font-family: "CommentXingKai", "STXingkai", "华文行楷", "Xingkai SC", "LXGW WenKai", "KaiTi", serif;
}

.bio-comment-line {
  text-align: left;
  color: #5c4a38;
  line-height: 1.75;
  margin: 0 0 14rpx;
  letter-spacing: 1rpx;
  font-family: "CommentXingKai", "STXingkai", "华文行楷", "Xingkai SC", "LXGW WenKai", "KaiTi", serif;
}

.bio-comment-line:last-child {
  margin-bottom: 24rpx;
}

.bio-p {
  margin: 0 0 24rpx;
  text-align: justify;
  line-height: 1.65;
  word-break: break-word;
}

.bio-p:last-child {
  margin-bottom: 0;
}

.bio-cursor {
  animation: bio-blink 0.8s infinite;
  color: #c4a574;
}

@keyframes bio-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}
