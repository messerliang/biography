<view class="page">
  <view class="chat-header">
    <view class="chat-tip">AI 会像朋友一样，引导您回忆人生故事。可文字输入或按住说话。</view>
    <view class="material-bar {{materialSufficient ? 'ok' : ''}}" wx:if="{{userMsgCount > 0 || materialTip}}">
      <text wx:if="{{materialSufficient}}">素材已较充分，可以生成传记</text>
      <text wx:else>{{materialTip || '建议多聊几轮再生成'}}</text>
    </view>
  </view>

  <scroll-view
    class="chat-list"
    scroll-y
    scroll-into-view="{{scrollTo}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="msg-row {{item.role === 'user' ? 'user' : 'assistant'}}">
      <view class="avatar" wx:if="{{item.role === 'assistant'}}">记</view>
      <view class="bubble">
        <text user-select>{{item.content}}</text>
      </view>
      <view class="avatar user-avatar" wx:if="{{item.role === 'user'}}">我</view>
    </view>

    <view wx:if="{{isTyping}}" class="msg-row assistant">
      <view class="avatar">记</view>
      <view class="bubble typing">
        <text>{{typingText}}</text>
        <text class="cursor">|</text>
      </view>
    </view>

    <view id="msg-bottom" style="height: 20rpx;"></view>
  </scroll-view>

  <view class="chat-footer">
    <view class="length-section">
      <view class="style-header" bindtap="toggleLengthPicker">
        <text class="style-label">传记篇幅</text>
        <text class="style-value">{{lengthLabel}}</text>
        <text class="style-arrow">{{showLengthPicker ? '▲' : '▼'}}</text>
      </view>
      <view class="style-panel" wx:if="{{showLengthPicker}}">
        <view
          class="style-option {{selectedLength === item.key ? 'active' : ''}}"
          wx:for="{{lengthOptions}}"
          wx:key="key"
          bindtap="selectLength"
          data-length="{{item.key}}"
        >
          <view class="style-option-name">{{item.label}}</view>
          <view class="style-option-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="style-section">
      <view class="style-header" bindtap="toggleStylePicker">
        <text class="style-label">传记风格</text>
        <text class="style-value">{{styleLabel}}</text>
        <text class="style-arrow">{{showStylePicker ? '▲' : '▼'}}</text>
      </view>
      <view class="style-panel" wx:if="{{showStylePicker}}">
        <block wx:for="{{styleGroups}}" wx:key="key">
          <view class="style-group-title">{{item.label}}</view>
          <view
            class="style-option {{selectedStyle === styleItem.key ? 'active' : ''}}"
            wx:for="{{item.styles}}"
            wx:for-item="styleItem"
            wx:key="key"
            bindtap="selectStyle"
            data-style="{{styleItem.key}}"
          >
            <view class="style-option-name">{{styleItem.label}}</view>
            <view class="style-option-desc">{{styleItem.desc}}</view>
          </view>
        </block>
      </view>
    </view>

    <view class="voice-status" wx:if="{{voiceStatus}}">{{voiceStatus}}</view>

    <view class="input-row">
      <view
        class="voice-btn {{recording ? 'recording' : ''}}"
        bindtouchstart="onVoiceTouchStart"
        bindtouchend="onVoiceTouchEnd"
        bindtouchcancel="onVoiceTouchCancel"
      >
        🎙
      </view>
      <input
        class="chat-input"
        placeholder="讲述您的故事……"
        value="{{inputValue}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="sendMessage"
        disabled="{{isTyping || recording}}"
      />
      <button class="send-btn" bindtap="sendMessage" disabled="{{isTyping || recording || !inputValue.trim()}}">发送</button>
    </view>

    <button class="generate-btn" bindtap="generateBiography" disabled="{{isTyping || recording || messages.length < 2}}">
      讲述完毕，生成传记
    </button>
  </view>
</view>
