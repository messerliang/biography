.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf6f0;
}

.chat-header {
  padding: 24rpx 32rpx 16rpx;
  background: #faf6f0;
}

.chat-tip {
  font-size: 24rpx;
  color: #8b7355;
  line-height: 1.5;
}

.chat-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  gap: 16rpx;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #c4a574;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar {
  background: #8b6914;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d2b1f;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.user .bubble {
  background: #3d2b1f;
  color: #faf6f0;
}

.typing .cursor {
  animation: blink 0.8s infinite;
  color: #c4a574;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.chat-footer {
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8dfd3;
}

.material-bar {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a0522d;
  background: #fdf5f0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
}

.material-bar.ok {
  color: #4a6b4e;
  background: #eef5ef;
}

.voice-status {
  font-size: 22rpx;
  color: #8b6914;
  text-align: center;
  margin-bottom: 8rpx;
}

.voice-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5efe6;
  border-radius: 50%;
  font-size: 32rpx;
  flex-shrink: 0;
}

.voice-btn.recording {
  background: #c4a574;
  transform: scale(1.05);
}

.input-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-end;
}

.chat-input {
  flex: 1;
  min-width: 0;
  background: #f5efe6;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  min-height: 72rpx;
  max-height: 240rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.send-btn {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c4a574;
  color: #fff;
  font-size: 26rpx;
  border-radius: 36rpx;
  box-sizing: border-box;
}

.send-btn--disabled {
  background: #ddd;
  color: #999;
  pointer-events: none;
}

.generate-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-sizing: border-box;
}

.generate-btn--disabled {
  background: #ddd;
  color: #999;
  pointer-events: none;
}
