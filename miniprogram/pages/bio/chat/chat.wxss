.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf6f0;
}

.chat-header {
  padding: 20rpx 32rpx;
  background: #f0ebe3;
}

.chat-tip {
  font-size: 24rpx;
  color: #8b7355;
  line-height: 1.5;
}

.chat-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  gap: 16rpx;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #c4a574;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar {
  background: #8b6914;
}

.bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d2b1f;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.user .bubble {
  background: #3d2b1f;
  color: #faf6f0;
}

.typing .cursor {
  animation: blink 0.8s infinite;
  color: #c4a574;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.chat-footer {
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8dfd3;
}

.style-section {
  margin-bottom: 16rpx;
}

.style-header {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.style-label {
  color: #a89580;
}

.style-value {
  flex: 1;
  text-align: right;
  color: #8b6914;
  font-weight: 500;
  margin-right: 8rpx;
}

.style-arrow {
  font-size: 20rpx;
  color: #a89580;
}

.style-panel {
  margin-top: 12rpx;
  max-height: 320rpx;
  overflow-y: auto;
  background: #faf6f0;
  border-radius: 16rpx;
  padding: 8rpx 16rpx 16rpx;
}

.style-group-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #8b7355;
  padding: 12rpx 8rpx 8rpx;
}

.style-option {
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #fff;
  border: 2rpx solid transparent;
}

.style-option.active {
  border-color: #c4a574;
  background: #fdf9f3;
}

.style-option-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.style-option-desc {
  font-size: 22rpx;
  color: #a89580;
  margin-top: 4rpx;
}

.chat-header {
  padding: 24rpx 32rpx 16rpx;
  background: #faf6f0;
}

.material-bar {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a0522d;
  background: #fdf5f0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
}

.material-bar.ok {
  color: #4a6b4e;
  background: #eef5ef;
}

.voice-status {
  font-size: 22rpx;
  color: #8b6914;
  text-align: center;
  margin-bottom: 8rpx;
}

.voice-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5efe6;
  border-radius: 50%;
  font-size: 32rpx;
  flex-shrink: 0;
}

.voice-btn.recording {
  background: #c4a574;
  transform: scale(1.05);
}

.input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  background: #f5efe6;
  border-radius: 40rpx;
  padding: 0 28rpx;
  height: 72rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  background: #c4a574;
  color: #fff;
  font-size: 26rpx;
  border-radius: 36rpx;
  border: none;
}

.send-btn[disabled] {
  background: #ddd;
  color: #999;
}

.generate-btn {
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
}

.generate-btn[disabled] {
  background: #ddd;
  color: #999;
}
