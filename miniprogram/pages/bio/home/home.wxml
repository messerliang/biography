<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view class="hero-title">人生传记</view>
      <view class="hero-divider"></view>
      <view class="hero-subtitle">
        <view class="hero-subtitle-line">记录故事</view>
        <view class="hero-subtitle-line">传承记忆</view>
      </view>
    </view>
    <view class="hero-desc">四种方式，选择最适合您的创作路径</view>
  </view>

  <!-- 时间轴创作 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">时间轴创作</text>
      <text class="section-tip section-tip-gold">推荐</text>
    </view>
    <view class="featured-dark" bindtap="goTimeline">
      <image class="featured-dark-deco" src="/assets/bio/timeline-card-deco.svg" mode="aspectFill"/>
      <view class="featured-dark-content">
        <view class="featured-dark-main">
          <view class="featured-dark-icon">
            <image class="card-icon-img card-icon-img--dark" src="/assets/bio/icons/icon-timeline-dark.svg" mode="aspectFit"/>
          </view>
          <view class="featured-dark-text">
            <view class="featured-dark-title">时间轴填写</view>
            <view class="featured-dark-desc">按人生节点逐条记录关键事件，清晰梳理一生轨迹</view>
          </view>
        </view>
        <view class="featured-dark-action">开始 ›</view>
      </view>
    </view>
  </view>

  <!-- 文字记录（浅色） -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">文字记录</text>
      <text class="section-tip">动笔书写 · 对话回忆</text>
    </view>
    <view class="card-grid">
      <view class="mini-card" bindtap="goForm">
        <view class="mini-head">
          <view class="mini-icon form-icon">
            <image class="card-icon-img" src="/assets/bio/icons/icon-form.svg" mode="aspectFit"/>
          </view>
          <view class="mini-title">分步填写</view>
        </view>
        <view class="mini-desc">按章节填写，适合回忆清晰、想快速成稿</view>
      </view>
      <view class="mini-card" bindtap="goChat">
        <view class="mini-head">
          <view class="mini-icon chat-icon">
            <image class="card-icon-img" src="/assets/bio/icons/icon-chat.svg" mode="aspectFit"/>
          </view>
          <view class="mini-title">AI 访谈</view>
        </view>
        <view class="mini-desc">像聊天一样被引导回忆，适合不知从何说起</view>
      </view>
    </view>
  </view>

  <!-- 视频讲述（浅色） -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">视频讲述</text>
      <text class="section-tip">语音自动识别</text>
    </view>
    <view class="card" bindtap="goVideo">
      <view class="card-main">
        <view class="card-icon video-icon">
          <image class="card-icon-img card-icon-img--lg" src="/assets/bio/icons/icon-video.svg" mode="aspectFit"/>
        </view>
        <view class="card-body">
          <view class="card-title">视频口述</view>
          <view class="card-desc">拍摄或从相册导入讲述视频，AI 提取语音并生成传记</view>
          <view class="light-tags">
            <text class="light-tag">相册导入</text>
            <text class="light-tag">现场拍摄</text>
            <text class="light-tag">最长 10 分钟</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="history-link" bindtap="goHistory">
    <text class="history-icon">📚</text>
    <text>我的传记</text>
    <text class="history-count" wx:if="{{historyCount > 0}}">（{{historyCount}}）</text>
  </view>
</view>
