<view class="page">
  <view class="hero">
    <view class="hero-title">人生传记</view>
    <view class="hero-subtitle">记录故事，传承记忆</view>
    <view class="hero-desc">三种方式，帮您把人生经历写成一篇温暖的传记</view>
  </view>

  <!-- 视频导入快捷区 -->
  <view class="video-zone" bindtap="goVideo">
    <view class="video-zone-left">
      <view class="video-zone-icon">🎬</view>
      <view class="video-zone-text">
        <view class="video-zone-title">导入视频解析</view>
        <view class="video-zone-desc">上传口述视频，AI 自动提取语音并生成传记</view>
      </view>
    </view>
    <view class="video-zone-action">导入 ›</view>
  </view>

  <view class="cards">
    <view class="card" bindtap="goForm">
      <view class="card-icon form-icon">📝</view>
      <view class="card-body">
        <view class="card-title">分步填写</view>
        <view class="card-desc">按章节填写人生经历，适合已有清晰回忆、想快速成稿的用户</view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <view class="card" bindtap="goChat">
      <view class="card-icon chat-icon">💬</view>
      <view class="card-body">
        <view class="card-title">AI 访谈</view>
        <view class="card-desc">像聊天一样被温和引导回忆，适合喜欢口述、不确定从何写起的用户</view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <view class="card" bindtap="goVideo">
      <view class="card-icon video-icon">🎥</view>
      <view class="card-body">
        <view class="card-title">视频口述</view>
        <view class="card-desc">拍摄或导入讲述视频，自动识别语音内容并整理成传记</view>
      </view>
      <view class="card-arrow">›</view>
    </view>
  </view>

  <view class="history-link" bindtap="goHistory">
    <text class="history-icon">📚</text>
    <text>我的传记</text>
    <text class="history-count" wx:if="{{historyCount > 0}}">（{{historyCount}}）</text>
  </view>
</view>
