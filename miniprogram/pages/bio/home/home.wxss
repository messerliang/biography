.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #faf6f0 0%, #f5efe6 100%);
  padding: 32rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  padding: 24rpx 0 40rpx;
  box-sizing: border-box;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.hero-title {
  font-size: 58rpx;
  font-weight: 700;
  color: #3d2b1f;
  letter-spacing: 4rpx;
  line-height: 1.15;
  flex-shrink: 0;
}

.hero-divider {
  width: 2rpx;
  height: 76rpx;
  flex-shrink: 0;
  background: linear-gradient(
    180deg,
    rgba(196, 165, 116, 0) 0%,
    rgba(212, 184, 138, 0.85) 22%,
    #c4a574 50%,
    rgba(212, 184, 138, 0.85) 78%,
    rgba(196, 165, 116, 0) 100%
  );
  border-radius: 2rpx;
  box-shadow: 0 0 12rpx rgba(196, 165, 116, 0.18);
}

.hero-subtitle {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-left: 0;
}

.hero-subtitle-line {
  font-size: 28rpx;
  color: #8b7355;
  letter-spacing: 3rpx;
  line-height: 1.35;
  text-align: left;
}

.hero-desc {
  font-size: 28rpx;
  color: #a89580;
  margin-top: 28rpx;
  line-height: 1.55;
  text-align: center;
  padding: 0 12rpx;
}

.hero-desc::before {
  content: '';
  display: block;
  width: 85%;
  max-width: 560rpx;
  height: 2rpx;
  margin: 0 auto 18rpx;
  background: linear-gradient(
    90deg,
    rgba(196, 165, 116, 0) 0%,
    rgba(196, 165, 116, 0.55) 50%,
    rgba(196, 165, 116, 0) 100%
  );
  border-radius: 2rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.section-tip {
  font-size: 22rpx;
  color: #a89580;
}

.section-tip-gold {
  color: #3d2b1f;
  background: linear-gradient(135deg, #d4b88a 0%, #c4a574 100%);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 2rpx 8rpx rgba(196, 165, 116, 0.25);
  align-self: center;
}

/* 推荐：深色色卡 */
.featured-dark {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #3d2b1f 0%, #5c4033 55%, #4a3428 100%);
  border-radius: 28rpx;
  padding: 0;
  box-shadow:
    0 12rpx 40rpx rgba(61, 43, 31, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(196, 165, 116, 0.15);
}

.featured-dark-deco {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
  pointer-events: none;
}

.featured-dark-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  padding: 29rpx;
}

.featured-dark::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid rgba(196, 165, 116, 0.22);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
  box-sizing: border-box;
}

.featured-dark:active {
  opacity: 0.92;
}

.featured-dark-main {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.featured-dark-icon {
  position: relative;
  width: 79rpx;
  height: 79rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(145deg, rgba(212, 184, 138, 0.22) 0%, rgba(196, 165, 116, 0.08) 100%);
  border: 1rpx solid rgba(212, 184, 138, 0.35);
  box-shadow:
    inset 0 2rpx 12rpx rgba(255, 255, 255, 0.06),
    0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}

.featured-dark-icon::after {
  content: '';
  position: absolute;
  inset: 6rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(245, 234, 213, 0.08);
  pointer-events: none;
}

.featured-dark-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #faf6f0;
}

.featured-dark-desc {
  font-size: 24rpx;
  color: #c4a574;
  margin-top: 8rpx;
  line-height: 1.45;
}

.featured-dark-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-end;
  margin-top: 25rpx;
  padding: 13rpx 25rpx;
  font-size: 28rpx;
  color: #3d2b1f;
  font-weight: 600;
  background: linear-gradient(135deg, #d4b88a 0%, #c4a574 100%);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 浅色色卡 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 43, 31, 0.08);
}

.card:active {
  background: #fdfbf8;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.card-main {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-width: 0;
}

.card-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.85),
    0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.form-icon {
  background: linear-gradient(145deg, #f5efe6 0%, #ebe3d6 100%);
  border: 1rpx solid rgba(196, 165, 116, 0.2);
}

.chat-icon {
  background: linear-gradient(145deg, #eef5f0 0%, #dde8e0 100%);
  border: 1rpx solid rgba(90, 122, 98, 0.18);
}

.video-icon {
  background: linear-gradient(145deg, #f0edf5 0%, #e4dfea 100%);
  border: 1rpx solid rgba(107, 95, 138, 0.18);
}

.card-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.card-icon-img--lg {
  width: 48rpx;
  height: 48rpx;
}

.card-icon-img--dark {
  width: 47rpx;
  height: 47rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.card-desc {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 10rpx;
  line-height: 1.5;
}

.light-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.light-tag {
  font-size: 20rpx;
  color: #8b7355;
  background: #f5efe6;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.card-grid {
  display: flex;
  gap: 20rpx;
}

.mini-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 43, 31, 0.08);
  box-sizing: border-box;
}

.mini-card:active {
  background: #fdfbf8;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.mini-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-icon {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow:
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.8),
    0 3rpx 12rpx rgba(61, 43, 31, 0.05);
}

.mini-icon .card-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.mini-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.mini-desc {
  font-size: 22rpx;
  color: #8b7355;
  margin-top: 16rpx;
  line-height: 1.5;
}

.history-link {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: #8b7355;
  gap: 8rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 43, 31, 0.06);
}

.history-count {
  color: #c4a574;
}
