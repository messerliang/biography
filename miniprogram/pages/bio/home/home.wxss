.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #faf6f0 0%, #f5efe6 100%);
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  padding: 48rpx 0 56rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #3d2b1f;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #8b7355;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #a89580;
  margin-top: 24rpx;
  line-height: 1.6;
  padding: 0 20rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.section-tip {
  font-size: 22rpx;
  color: #a89580;
}

/* 推荐：深色色卡 */
.featured-dark {
  background: linear-gradient(135deg, #3d2b1f 0%, #5c4033 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 43, 31, 0.25);
}

.featured-dark:active {
  opacity: 0.92;
}

.featured-dark-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.featured-dark-label {
  font-size: 24rpx;
  color: #c4a574;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.featured-dark-badge {
  font-size: 20rpx;
  color: #3d2b1f;
  background: #c4a574;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.featured-dark-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.featured-dark-icon {
  font-size: 48rpx;
  flex-shrink: 0;
  line-height: 1;
}

.featured-dark-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #faf6f0;
}

.featured-dark-desc {
  font-size: 24rpx;
  color: #c4a574;
  margin-top: 10rpx;
  line-height: 1.55;
}

.featured-dark-action {
  text-align: right;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #c4a574;
  font-weight: 600;
}

/* 浅色色卡 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 43, 31, 0.08);
}

.card:active {
  background: #fdfbf8;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.card-main {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-width: 0;
}

.card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.form-icon {
  background: #f0ebe3;
}

.chat-icon {
  background: #e8f0ea;
}

.video-icon {
  background: #ebe8f5;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.card-desc {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 10rpx;
  line-height: 1.5;
}

.light-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.light-tag {
  font-size: 20rpx;
  color: #8b7355;
  background: #f5efe6;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.card-grid {
  display: flex;
  gap: 20rpx;
}

.mini-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 43, 31, 0.08);
  box-sizing: border-box;
}

.mini-card:active {
  background: #fdfbf8;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.mini-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mini-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.mini-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.mini-desc {
  font-size: 22rpx;
  color: #8b7355;
  margin-top: 16rpx;
  line-height: 1.5;
}

.history-link {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: #8b7355;
  gap: 8rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 43, 31, 0.06);
}

.history-count {
  color: #c4a574;
}
