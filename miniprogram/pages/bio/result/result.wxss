.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf6f0;
}

.header {
  padding: 32rpx 40rpx 24rpx;
  border-bottom: 1rpx solid #e8dfd3;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.status {
  font-size: 24rpx;
  color: #c4a574;
  margin-top: 12rpx;
}

.status.done {
  color: #6b8f71;
}

.save-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 40rpx 16rpx;
  padding: 24rpx 28rpx;
  background: #fdf9f3;
  border: 1rpx solid #e8dfd3;
  border-radius: 16rpx;
}

.save-banner-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.save-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.save-banner-desc {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 6rpx;
  line-height: 1.5;
}

.saved-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 40rpx 16rpx;
  padding: 20rpx 28rpx;
  background: #eef5ef;
  border-radius: 16rpx;
}

.saved-banner-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #6b8f71;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  flex-shrink: 0;
}

.saved-banner-text {
  font-size: 26rpx;
  color: #4a6b4e;
}

.dot {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.content-scroll {
  flex: 1;
  padding: 32rpx 40rpx;
  box-sizing: border-box;
}

.content-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 43, 31, 0.08);
  min-height: 400rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8dfd3;
}

.error-tip {
  width: 100%;
  font-size: 24rpx;
  color: #a0522d;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.action-btn {
  flex: 1;
  min-width: calc(50% - 12rpx);
  height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  box-sizing: border-box;
}

.share-hint {
  width: 100%;
  font-size: 22rpx;
  color: #8b7355;
  line-height: 1.5;
  text-align: center;
  margin-top: -8rpx;
}

.action-btn::after {
  border: none;
}

.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 12000px;
}

.resonance-panel {
  margin: 24rpx 0 0;
  padding: 0 4rpx;
}

.resonance-teaser,
.resonance-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 43, 31, 0.08);
  border: 1rpx solid #e8dfd3;
}

.resonance-teaser-title,
.resonance-card-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #8b6914;
}

.resonance-teaser-desc {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 12rpx;
  line-height: 1.6;
}

.resonance-reveal-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin-top: 24rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #c4a574 0%, #8b6914 100%);
  color: #fff;
  border: none;
  padding: 0;
}

.resonance-reveal-btn::after {
  border: none;
}

.resonance-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d2b1f;
  margin-top: 16rpx;
}

.resonance-alias,
.resonance-era {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 8rpx;
}

.resonance-tagline {
  font-size: 26rpx;
  color: #6b5344;
  margin-top: 12rpx;
  line-height: 1.6;
}

.resonance-section {
  font-size: 26rpx;
  font-weight: 600;
  color: #8b6914;
  margin-top: 28rpx;
  margin-bottom: 8rpx;
}

.resonance-reason,
.resonance-story,
.resonance-bridge {
  font-size: 26rpx;
  color: #3d2b1f;
  line-height: 1.75;
  margin-bottom: 6rpx;
}

.resonance-bridge {
  color: #5c4a3a;
}

.resonance-disclaimer {
  font-size: 22rpx;
  color: #a89580;
  margin-top: 24rpx;
  line-height: 1.5;
}

.resonance-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 28rpx;
}

.resonance-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
  padding: 0;
  margin: 0;
}

.resonance-btn::after {
  border: none;
}

.resonance-btn.primary {
  background: linear-gradient(135deg, #c4a574 0%, #8b6914 100%);
  color: #fff;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
}
