.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf6f0;
}

.header {
  padding: 32rpx 40rpx 24rpx;
  border-bottom: 1rpx solid #e8dfd3;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.status {
  font-size: 24rpx;
  color: #c4a574;
  margin-top: 12rpx;
}

.status.done {
  color: #6b8f71;
}

.dot {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.content-scroll {
  flex: 1;
  padding: 32rpx 40rpx;
  box-sizing: border-box;
}

.content-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  font-size: 30rpx;
  line-height: 2;
  color: #3d2b1f;
  box-shadow: 0 4rpx 24rpx rgba(61, 43, 31, 0.08);
  min-height: 400rpx;
  white-space: pre-wrap;
}

.cursor {
  animation: blink 0.8s infinite;
  color: #c4a574;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.actions {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8dfd3;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
}
