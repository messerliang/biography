.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf6f0;
  box-sizing: border-box;
}

.header {
  padding: 32rpx 40rpx 24rpx;
  border-bottom: 1rpx solid #e8dfd3;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.meta {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 12rpx;
}

.loading-wrap,
.error-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #8b7355;
}

.error-title {
  font-size: 30rpx;
  color: #3d2b1f;
  text-align: center;
  line-height: 1.6;
}

.error-desc {
  font-size: 26rpx;
  color: #a89580;
  margin-top: 16rpx;
  text-align: center;
}

.content-scroll {
  flex: 1;
  height: 0;
}

.content-box {
  padding: 32rpx 40rpx 48rpx;
}

.footer {
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #faf6f0;
  border-top: 1rpx solid #e8dfd3;
}

.footer-tip {
  font-size: 24rpx;
  color: #8b7355;
  text-align: center;
  margin-bottom: 20rpx;
}

.cta-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
  padding: 0;
  margin: 0;
}

.cta-btn::after {
  border: none;
}

.cta-btn.primary {
  background: linear-gradient(135deg, #c4a574 0%, #8b6914 100%);
  color: #fff;
  border: none;
}

.error-wrap .cta-btn {
  margin-top: 40rpx;
  max-width: 480rpx;
}
