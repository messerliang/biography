.page {
  min-height: 100vh;
  padding: 32rpx 40rpx 0;
  background: linear-gradient(180deg, #faf6f0 0%, #f5efe6 100%);
  box-sizing: border-box;
}

.header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.header-desc {
  font-size: 26rpx;
  color: #8b7355;
  margin-top: 12rpx;
  line-height: 1.6;
}

.summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.summary-label {
  color: #a89580;
}

.summary-value {
  color: #8b6914;
  font-weight: 600;
}

.person-section,
.picker-block {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 0 28rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
  border: 1rpx solid rgba(232, 223, 211, 0.75);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
  padding: 28rpx 0 8rpx;
}

.option-list {
  padding-bottom: 16rpx;
}

.option-item,
.picker-item {
  padding: 24rpx 0 24rpx 56rpx;
  border-bottom: 1rpx solid #f5efe6;
}

.option-item:last-child,
.picker-item:last-child {
  border-bottom: none;
}

.option-item.active .option-label,
.picker-item.active .picker-item-label {
  color: #8b6914;
}

.option-label,
.picker-item-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.option-desc,
.picker-item-desc {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 6rpx;
  padding-left: 56rpx;
}

.picker-header {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.picker-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #8b6914;
  margin-right: 12rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #a89580;
}

.picker-list {
  border-top: 1rpx solid #f0ebe3;
  padding-bottom: 12rpx;
}

.group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8b7355;
  padding: 20rpx 0 8rpx;
  text-align: center;
}

.footer-spacer {
  height: calc(136rpx + env(safe-area-inset-bottom));
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #faf6f0;
  border-top: 1rpx solid rgba(232, 223, 211, 0.8);
  box-sizing: border-box;
}

.btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
}

.btn-primary {
  background: linear-gradient(135deg, #c4a574 0%, #8b6914 100%);
  color: #fff;
}
