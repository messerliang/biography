.page {
  min-height: 100vh;
  background: #faf6f0;
  padding: 32rpx 40rpx 180rpx;
  box-sizing: border-box;
}

.import-zone {
  margin-top: 80rpx;
  background: #fff;
  border: 2rpx dashed #c4a574;
  border-radius: 24rpx;
  padding: 80rpx 48rpx;
  text-align: center;
}

.import-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.import-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.import-desc {
  font-size: 26rpx;
  color: #8b7355;
  margin-top: 16rpx;
  line-height: 1.6;
}

.import-tip {
  font-size: 22rpx;
  color: #a89580;
  margin-top: 24rpx;
}

.video-panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 43, 31, 0.08);
}

.video-preview {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: #000;
}

.video-meta {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 16rpx;
  text-align: center;
}

.dot {
  margin: 0 8rpx;
}

.status-box {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #fdf9f3;
  border-radius: 16rpx;
}

.status-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8b6914;
  margin-bottom: 16rpx;
}

.status-tip {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 12rpx;
}

.transcript-box {
  margin-top: 32rpx;
}

.transcript-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.transcript-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.reparse {
  font-size: 24rpx;
  color: #8b6914;
}

.transcript-input {
  width: 100%;
  min-height: 200rpx;
  background: #f5efe6;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d2b1f;
  box-sizing: border-box;
}

.style-section {
  margin-top: 32rpx;
}

.style-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
  margin-bottom: 16rpx;
}

.style-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.style-item {
  padding: 20rpx 24rpx;
  background: #f5efe6;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.style-item.active {
  border-color: #c4a574;
  background: #fdf9f3;
}

.style-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.style-desc {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 4rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #faf6f0;
  border-top: 1rpx solid #e8dfd3;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
}

.btn[disabled] {
  background: #ddd;
  color: #999;
  border-color: #ddd;
}
