.page-wrap {
  min-height: 100vh;
  background: #faf6f0;
}

.page {
  padding: 0 40rpx 200rpx;
  box-sizing: border-box;
}

.header {
  padding: 32rpx 0 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.header-desc {
  font-size: 26rpx;
  color: #8b7355;
  margin-top: 12rpx;
  line-height: 1.6;
}

.header-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.header-stats {
  font-size: 24rpx;
  flex: 1;
  min-width: 0;
}

.stats-filled {
  color: #8b6914;
  font-weight: 600;
}

.stats-divider {
  color: #c4a574;
  margin: 0 6rpx;
}

.stats-total {
  color: #a89580;
}

.sort-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8b7355;
  line-height: 1.5;
}

.sort-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  color: #8b6914;
  font-weight: 600;
  background: rgba(196, 165, 116, 0.18);
  border: 1rpx solid rgba(196, 165, 116, 0.45);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sort-toggle.active {
  background: #fdf9f3;
  border-color: #c4a574;
  color: #6d5610;
}

.sort-toggle-icon {
  font-size: 26rpx;
  line-height: 1;
}

.node-sorting {
  border-left: 6rpx solid #c4a574;
}

.node-sort-actions {
  display: flex;
  border-top: 1rpx solid #f0ebe3;
}

.sort-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #8b6914;
}

.sort-btn:active {
  background: #faf6f0;
}

.timeline {
  position: relative;
  padding-left: 32rpx;
}

.timeline-line {
  position: absolute;
  left: 14rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #c4a574 0%, #e8dfd3 100%);
  border-radius: 2rpx;
}

.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 28rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #e8dfd3;
  border: 4rpx solid #faf6f0;
  box-sizing: border-box;
  z-index: 1;
}

.dot-filled {
  background: #c4a574;
  box-shadow: 0 0 0 4rpx rgba(196, 165, 116, 0.25);
}

.dot-example {
  background: #8b7355;
}

.dot-empty {
  background: #fff;
  border: 4rpx solid #c4a574;
}

.node-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(61, 43, 31, 0.08);
  overflow: hidden;
}

.node-example {
  border-left: 6rpx solid #8b7355;
}

.node-empty {
  border: 2rpx dashed #e8dfd3;
  background: #fdfbf8;
  box-shadow: none;
}

.node-main {
  padding: 28rpx 28rpx 20rpx;
}

.node-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.node-date {
  font-size: 24rpx;
  color: #8b6914;
  font-weight: 600;
}

.example-badge {
  font-size: 20rpx;
  color: #8b7355;
  background: #f0ebe3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.node-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d2b1f;
  margin-bottom: 10rpx;
}

.node-desc {
  font-size: 26rpx;
  color: #8b7355;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.placeholder {
  color: #c4b8a8;
  font-weight: 400;
}

.node-delete {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #a89580;
  border-top: 1rpx solid #f0ebe3;
}

.node-delete:active {
  background: #faf6f0;
  color: #8b6914;
}

.add-section {
  margin-top: 16rpx;
  text-align: center;
}

.btn-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #8b6914;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx dashed #c4a574;
  border-radius: 44rpx;
  padding: 20rpx 48rpx;
  line-height: 1.4;
}

.btn-add::after {
  border: none;
}

.reset-link {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #a89580;
  text-decoration: underline;
}

.style-section {
  margin-top: 48rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.style-header {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.style-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.style-current {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #8b6914;
  margin-right: 12rpx;
}

.style-note {
  font-size: 22rpx;
  color: #a89580;
  padding: 0 0 16rpx;
  line-height: 1.5;
}

.style-arrow {
  font-size: 20rpx;
  color: #a89580;
}

.style-list {
  padding-bottom: 20rpx;
  border-top: 1rpx solid #f0ebe3;
}

.style-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8b7355;
  padding: 20rpx 0 8rpx;
}

.style-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5efe6;
}

.style-item:last-child {
  border-bottom: none;
}

.style-item.active .style-item-label {
  color: #8b6914;
}

.style-item-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.style-item-desc {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 6rpx;
}

.footer-spacer {
  height: 40rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #faf6f0;
  border-top: 1rpx solid #e8dfd3;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
}

.btn-primary::after {
  border: none;
}
