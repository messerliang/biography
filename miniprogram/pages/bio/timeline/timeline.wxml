<view class="page-wrap">
  <view class="page-bg" aria-hidden="true">
    <view class="page-bg-river"></view>
    <image class="page-bg-image" src="/assets/bio/timeline-bg.svg" mode="aspectFill"/>
    <view class="page-bg-fade"></view>
    <view class="bg-marker bg-marker-1"></view>
    <view class="bg-marker bg-marker-2"></view>
    <view class="bg-marker bg-marker-3"></view>
  </view>
  <view class="page">
  <view class="header">
    <view class="header-title">梳理人生关键节点</view>
    <view class="header-desc">点击节点填写时间、事件与详情，按时间线串联您的人生故事</view>
    <view class="header-stats-row">
      <view class="header-stats">
        <text class="stats-filled">已填写 {{filledCount}}</text>
        <text class="stats-divider">/</text>
        <text class="stats-total">共 {{totalCount}} 个节点</text>
      </view>
      <view class="sort-toggle {{sortMode ? 'active' : ''}}" bindtap="toggleSortMode">
        <text class="sort-toggle-icon">⇅</text>
        <text>{{sortMode ? '完成排序' : '调整顺序'}}</text>
      </view>
    </view>
    <view class="sort-tip" wx:if="{{sortMode}}">使用 ↑↓ 调整节点顺序</view>
  </view>

  <view class="timeline">
    <view class="timeline-line"></view>

    <block wx:for="{{sortedNodes}}" wx:key="id">
      <view class="timeline-item">
        <view class="timeline-dot {{item.isExample ? 'dot-example' : ''}} {{item.filled ? 'dot-filled' : 'dot-empty'}}"></view>

        <view class="node-card {{item.isExample ? 'node-example' : ''}} {{!item.filled ? 'node-empty' : ''}} {{sortMode ? 'node-sorting' : ''}}">
          <view class="node-main" bindtap="editNode" data-id="{{item.id}}">
            <view class="node-top">
              <view class="node-date" wx:if="{{item.date}}">{{item.date}}</view>
              <view class="node-date placeholder" wx:else>点击填写时间</view>
              <view class="example-badge" wx:if="{{item.isExample}}">示例</view>
            </view>
            <view class="node-title" wx:if="{{item.title}}">{{item.title}}</view>
            <view class="node-title placeholder" wx:else>点击填写节点名称</view>
            <view class="node-desc {{item.descPlaceholder ? 'placeholder' : ''}}">{{item.descPreview}}</view>
          </view>
          <view class="node-sort-actions" wx:if="{{sortMode}}">
            <text class="sort-btn" catchtap="moveNode" data-id="{{item.id}}" data-direction="up">↑ 上移</text>
            <text class="sort-btn" catchtap="moveNode" data-id="{{item.id}}" data-direction="down">↓ 下移</text>
          </view>
          <view
            class="node-delete"
            wx:if="{{totalCount > 1 && !sortMode}}"
            catchtap="deleteNode"
            data-id="{{item.id}}"
          >
            删除
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="add-section">
    <button class="btn-add" bindtap="addNode">＋ 增加节点</button>
    <view class="reset-link" bindtap="resetExamples">恢复示例节点</view>
  </view>

  <view class="length-section">
    <view class="style-header" bindtap="toggleLengthPicker">
      <text class="style-label">传记篇幅</text>
      <text class="style-current">{{lengthLabel}}</text>
      <text class="style-arrow">{{showLengthPicker ? '▲' : '▼'}}</text>
    </view>
    <view class="style-list" wx:if="{{showLengthPicker}}">
      <view
        class="style-item {{selectedLength === item.key ? 'active' : ''}}"
        wx:for="{{lengthOptions}}"
        wx:key="key"
        bindtap="selectLength"
        data-length="{{item.key}}"
      >
        <view class="style-item-label">{{item.label}}</view>
        <view class="style-item-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="style-section">
    <view class="style-header" bindtap="toggleStylePicker">
      <text class="style-label">传记风格</text>
      <text class="style-current">{{styleLabel}}</text>
      <text class="style-arrow">{{showStylePicker ? '▲' : '▼'}}</text>
    </view>
    <view class="style-note">内容将按节点顺序成篇，此处选择篇幅与文笔风格</view>
    <view class="style-list" wx:if="{{showStylePicker}}">
      <block wx:for="{{styleGroups}}" wx:key="key">
        <view class="style-group-title">{{item.label}}</view>
        <view
          class="style-item {{selectedStyle === styleItem.key ? 'active' : ''}}"
          wx:for="{{item.styles}}"
          wx:for-item="styleItem"
          wx:key="key"
          bindtap="selectStyle"
          data-style="{{styleItem.key}}"
        >
          <view class="style-item-label">{{styleItem.label}}</view>
          <view class="style-item-desc">{{styleItem.desc}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="footer-spacer"></view>
  </view>

  <view class="footer">
    <button class="btn btn-primary" bindtap="generate">生成传记</button>
  </view>
</view>
