.page {
  min-height: 100vh;
  background: #faf6f0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.loading-wrap,
.error-wrap {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.loading-text,
.error-title {
  font-size: 28rpx;
  color: #8b7355;
  text-align: center;
}

.card {
  margin: 32rpx 40rpx;
  padding: 36rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(61, 43, 31, 0.08);
}

.card-header {
  font-size: 26rpx;
  color: #8b6914;
  font-weight: 600;
}

.card-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #3d2b1f;
  margin-top: 20rpx;
}

.card-alias,
.card-era {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 8rpx;
}

.card-tagline {
  font-size: 26rpx;
  color: #6b5344;
  margin-top: 16rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8b6914;
  margin-top: 32rpx;
  margin-bottom: 12rpx;
}

.reason,
.story,
.bridge {
  font-size: 28rpx;
  color: #3d2b1f;
  line-height: 1.75;
  margin-bottom: 8rpx;
}

.bridge {
  color: #5c4a3a;
}

.disclaimer {
  font-size: 22rpx;
  color: #a89580;
  margin-top: 32rpx;
  line-height: 1.5;
}

.footer {
  padding: 16rpx 40rpx 32rpx;
}

.footer-tip {
  font-size: 24rpx;
  color: #8b7355;
  text-align: center;
  margin-bottom: 20rpx;
}

.cta-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
  padding: 0;
  margin: 0 0 20rpx;
}

.cta-btn::after {
  border: none;
}

.cta-btn.primary {
  background: linear-gradient(135deg, #c4a574 0%, #8b6914 100%);
  color: #fff;
  border: none;
}

.error-wrap .cta-btn {
  margin-top: 40rpx;
  max-width: 480rpx;
}
