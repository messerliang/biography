.page {
  min-height: 100vh;
  background: #faf6f0;
  padding: 32rpx 40rpx;
  box-sizing: border-box;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #a89580;
  margin: 24rpx 0 48rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.item-meta {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 8rpx;
}

.dot {
  margin: 0 8rpx;
}

.item-preview {
  font-size: 26rpx;
  color: #8b7355;
  margin-top: 16rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-actions {
  margin-top: 16rpx;
  text-align: right;
}

.del-btn {
  background: transparent;
  color: #c45c5c;
  font-size: 24rpx;
  border: none;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 85%;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2b1f;
  margin-bottom: 24rpx;
}

.modal-scroll {
  flex: 1;
  max-height: 50vh;
}

.modal-body {
  padding: 8rpx 0 16rpx;
}

.modal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  min-width: calc(50% - 12rpx);
  height: 80rpx;
  padding: 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: #f5efe6;
  color: #8b6914;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  box-sizing: border-box;
}

.modal-btn::after {
  border: none;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
}

.toolbar {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.search-clear {
  font-size: 24rpx;
  color: #8b6914;
  margin-left: 16rpx;
}

.filter-tabs {
  white-space: nowrap;
}

.filter-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #8b7355;
  background: #fff;
  border-radius: 999rpx;
}

.filter-tab.active {
  background: #fdf9f3;
  color: #8b6914;
  font-weight: 600;
}

.sample-section {
  width: 100%;
  margin-top: 48rpx;
  text-align: left;
}

.sample-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.sample-desc {
  font-size: 24rpx;
  color: #a89580;
  margin: 8rpx 0 24rpx;
}

.sample-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.sample-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.sample-card-preview {
  font-size: 24rpx;
  color: #8b7355;
  margin-top: 12rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.empty-mini {
  text-align: center;
  padding: 80rpx 0;
}

.modal-header {
  margin-bottom: 16rpx;
}

.modal-meta {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 8rpx;
}

.read-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.read-label {
  font-size: 24rpx;
  color: #8b7355;
}

.read-btn {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #8b7355;
  background: #f5efe6;
  border-radius: 8rpx;
}

.read-btn.active {
  background: #c4a574;
  color: #fff;
}

.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 12000px;
}
