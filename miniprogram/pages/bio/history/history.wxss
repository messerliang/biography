.page {
  min-height: 100vh;
  background: #faf6f0;
  padding: 32rpx 40rpx;
  box-sizing: border-box;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #a89580;
  margin: 24rpx 0 48rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.item-meta {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 8rpx;
}

.dot {
  margin: 0 8rpx;
}

.item-preview {
  font-size: 26rpx;
  color: #8b7355;
  margin-top: 16rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-actions {
  margin-top: 16rpx;
  text-align: right;
}

.del-btn {
  background: transparent;
  color: #c45c5c;
  font-size: 24rpx;
  border: none;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 85%;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2b1f;
  margin-bottom: 24rpx;
}

.modal-scroll {
  flex: 1;
  max-height: 50vh;
}

.modal-text {
  font-size: 28rpx;
  line-height: 2;
  color: #3d2b1f;
  white-space: pre-wrap;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  background: #f5efe6;
  color: #8b6914;
  border: none;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
}
