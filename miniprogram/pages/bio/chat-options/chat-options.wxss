@import "../form-options/form-options.wxss";

.option-item--with-field {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.subject-name-wrap {
  margin: 0 56rpx 12rpx;
  padding: 0 0 8rpx;
}

.subject-name-input {
  width: 100%;
  height: 64rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #3d2b1f;
  background: #f8f4ed;
  border: 1rpx solid #e8dfd3;
  border-radius: 12rpx;
}

.subject-name-placeholder {
  color: #b8a990;
  font-size: 24rpx;
}
