<view class="page">
  <view class="header">
    <view class="header-title">确认生成设置</view>
    <view class="header-desc">选择叙述人称、篇幅与文笔风格，即可生成传记</view>
    <view class="summary">
      <text class="summary-label">访谈轮次</text>
      <text class="summary-value">用户 {{userMsgCount}} 条 · 共 {{messageCount}} 条</text>
    </view>
  </view>

  <view class="person-section">
    <view class="section-title">传记人称</view>
    <view class="option-list">
      <block wx:for="{{personOptions}}" wx:key="key">
        <view
          class="option-item {{selectedPerson === item.key ? 'active' : ''}}{{item.key === 'third' && selectedPerson === 'third' ? ' option-item--with-field' : ''}}"
          bindtap="selectPerson"
          data-person="{{item.key}}"
        >
          <view class="option-label">{{item.label}}</view>
          <view class="option-desc">{{item.desc}}</view>
        </view>
        <view class="subject-name-wrap" wx:if="{{item.key === 'third' && selectedPerson === 'third'}}">
          <input
            class="subject-name-input"
            type="text"
            value="{{subjectName}}"
            placeholder="主人公称呼，如张先生、母亲"
            placeholder-class="subject-name-placeholder"
            maxlength="20"
            bindinput="onSubjectNameInput"
            confirm-type="done"
          />
        </view>
      </block>
    </view>
  </view>

  <view class="picker-section">
    <view class="picker-block">
      <view class="picker-header" bindtap="toggleLengthPicker">
        <text class="picker-label">传记篇幅</text>
        <text class="picker-value">{{lengthLabel}}</text>
        <text class="picker-arrow">{{showLengthPicker ? '▲' : '▼'}}</text>
      </view>
      <view class="picker-list" wx:if="{{showLengthPicker}}">
        <view
          class="picker-item {{selectedLength === item.key ? 'active' : ''}}"
          wx:for="{{lengthOptions}}"
          wx:key="key"
          bindtap="selectLength"
          data-length="{{item.key}}"
        >
          <view class="picker-item-label">{{item.label}}</view>
          <view class="picker-item-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="picker-block">
      <view class="picker-header" bindtap="toggleStylePicker">
        <text class="picker-label">传记风格</text>
        <text class="picker-value">{{styleLabel}}</text>
        <text class="picker-arrow">{{showStylePicker ? '▲' : '▼'}}</text>
      </view>
      <view class="picker-list" wx:if="{{showStylePicker}}">
        <block wx:for="{{styleGroups}}" wx:key="key">
          <view class="group-title">{{item.label}}</view>
          <block wx:for="{{item.styles}}" wx:for-item="styleItem" wx:key="key">
            <view
              class="picker-item {{selectedStyle === styleItem.key ? 'active' : ''}}"
              bindtap="selectStyle"
              data-style="{{styleItem.key}}"
            >
              <view class="picker-item-label">{{styleItem.label}}</view>
              <view class="picker-item-desc">{{styleItem.desc}}</view>
            </view>
            <view class="wuxia-tone-inline" wx:if="{{styleItem.key === 'wuxia' && selectedStyle === 'wuxia'}}">
              <wuxia-tone-slider value="{{wuxiaTone}}" bind:change="onWuxiaToneChange" />
            </view>
            <view class="yanqing-tone-inline" wx:if="{{styleItem.key === 'yanqing' && selectedStyle === 'yanqing'}}">
              <yanqing-tone-slider value="{{yanqingTone}}" bind:change="onYanqingToneChange" />
            </view>
          </block>
        </block>
      </view>
      <view class="wuxia-tone-inline wuxia-tone-folded" wx:if="{{selectedStyle === 'wuxia' && !showStylePicker}}">
        <wuxia-tone-slider value="{{wuxiaTone}}" bind:change="onWuxiaToneChange" />
      </view>
      <view class="yanqing-tone-inline yanqing-tone-folded" wx:if="{{selectedStyle === 'yanqing' && !showStylePicker}}">
        <yanqing-tone-slider value="{{yanqingTone}}" bind:change="onYanqingToneChange" />
      </view>
    </view>
  </view>

  <view class="footer-spacer"></view>

  <view class="footer">
    <button class="btn btn-secondary" bindtap="goBack">上一步</button>
    <button class="btn btn-primary" bindtap="generate">生成传记</button>
  </view>
</view>
