.page {
  min-height: 100vh;
  background: #faf6f0;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.progress-bar {
  height: 6rpx;
  background: #e8dfd3;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #c4a574, #8b6914);
  transition: width 0.3s ease;
}

.step-indicator {
  text-align: center;
  font-size: 24rpx;
  color: #a89580;
  padding: 24rpx 0 0;
}

.step-header {
  padding: 32rpx 40rpx 24rpx;
}

.step-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.step-subtitle {
  font-size: 26rpx;
  color: #8b7355;
  margin-top: 12rpx;
}

.form-section {
  padding: 0 40rpx;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 500;
  color: #3d2b1f;
  margin-bottom: 16rpx;
}

.input {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #3d2b1f;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.textarea {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #3d2b1f;
  min-height: 240rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
  line-height: 1.6;
}

.style-section {
  margin-top: 16rpx;
}

.style-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.style-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(61, 43, 31, 0.06);
}

.style-item.active {
  border-color: #c4a574;
  background: #fdf9f3;
}

.style-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d2b1f;
}

.style-desc {
  font-size: 24rpx;
  color: #a89580;
  margin-top: 6rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #faf6f0;
  border-top: 1rpx solid #e8dfd3;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #c4a574, #8b6914);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #8b6914;
  border: 2rpx solid #c4a574;
}
